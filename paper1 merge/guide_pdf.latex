\documentclass[10pt,a4paper]{article}
\usepackage[margin=21mm]{geometry}
\usepackage{fontspec}
\setmainfont{Noto Serif CJK SC}
\setsansfont{Noto Sans CJK SC}
\setmonofont{Noto Sans Mono CJK SC}[Scale=0.85]
\XeTeXlinebreaklocale "zh"
\XeTeXlinebreakskip=0pt plus 1pt
\usepackage{amsmath,amssymb,longtable,booktabs,array,calc,etoolbox}
\usepackage{xcolor}
\definecolor{guideblue}{HTML}{244A68}
\usepackage{hyperref}
\hypersetup{colorlinks=true,linkcolor=guideblue,urlcolor=guideblue,pdftitle={$title$}}
\urlstyle{same}
\Urlmuskip=0mu plus 2mu\relax
\usepackage{titlesec}
\titleformat{\section}{\LARGE\sffamily\bfseries\color{guideblue}}{}{0em}{}
\titleformat{\subsection}{\large\sffamily\bfseries\color{guideblue}}{}{0em}{}
\titleformat{\subsubsection}{\normalsize\sffamily\bfseries}{}{0em}{}
\setcounter{secnumdepth}{0}
\setcounter{tocdepth}{2}
\renewcommand{\contentsname}{阅读目录}
\setlength{\parindent}{0pt}
\setlength{\parskip}{5pt plus 1pt}
\linespread{1.16}
\setlength{\emergencystretch}{3em}
\setlength{\tabcolsep}{4pt}
\renewcommand{\arraystretch}{1.15}
\AtBeginEnvironment{longtable}{\small}
\providecommand{\tightlist}{\setlength{\itemsep}{1pt}\setlength{\parskip}{0pt}}
